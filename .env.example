# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=iam-lab
KEYCLOAK_CLIENT_ID=demo-app
# Должен совпадать с secret клиента service-client в keycloak/realm-export.json
KEYCLOAK_CLIENT_SECRET=service-client-secret

# Demo app
APP_SECRET_KEY=change-me-random-secret-key
APP_HOST=http://localhost:8000

# PostgreSQL (используется Keycloak)
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me-db-password
